<!DOCTYPE html>
<html lang="ru" class="bg-gray-900 text-white">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>Proxye</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Alpine.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
</head>
<body x-data="proxyApp()" class="min-h-screen flex items-center justify-center p-4 font-sans">
<div class="w-full max-w-2xl bg-gray-800 p-6 rounded-lg shadow-lg">
    <h1 class="text-2xl font-bold mb-4 text-center">Proxye</h1>
    <div class="space-y-4" x-data>
        <!-- Proxy Host -->
        <div>
            <label class="block mb-1 font-semibold" for="proxyHost">Хост</label>
            <input
                autocomplete="off"
                x-model="proxyHost"
                type="text" 
                id="proxyHost" 
                class="w-full p-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Введите прокси хост"
            />
        </div>
        <!-- Proxy Port -->
        <div>
            <label class="block mb-1 font-semibold" for="proxyPort">Порт</label>
            <input
                autocomplete="off"
                x-model="proxyPort"
                type="number" 
                id="proxyPort" 
                class="w-full p-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                placeholder="Введите порт прокси"
            />
        </div>
        <!-- RegEx List -->
        <div>
            <label class="block mb-1 font-semibold">Обходить сайты</label>
            <div class="flex items-center mb-2">
                <input 
                    x-model="newRegex"
                    type="text"
                    class="flex-1 p-2 rounded bg-gray-700 text-white focus:outline-none focus:ring-2 focus:ring-blue-500"
                    placeholder="Часть домена"
                />
                <button 
                    @@click.prevent="addRegex"
                    class="ml-2 bg-green-600 hover:bg-green-700 px-3 py-1 rounded font-semibold"
                >
                    Добавить
                </button>
            </div>
            <ul class="h-48 overflow-y-auto bg-gray-700 p-2 rounded">
                <template x-for="(regex, index) in regexList" :key="index">
                    <li class="flex items-center justify-between mb-1 p-2 bg-gray-600 rounded">
                        <span x-text="regex"></span>
                        <button
                            @@click.prevent="removeRegex(index)"
                            class="ml-2 text-red-500 hover:text-red-700"
                            title="Удалить"
                        >
                            ×
                        </button>
                    </li>
                </template>
            </ul>
        </div>
        <!-- Submit Button -->
        <div>
            <button 
                @@click="submit"
                      class="w-full py-2 mt-2 bg-blue-600 hover:bg-blue-700 rounded text-white font-bold"
            >
                Сохранить
            </button>
            <template x-if="message">
                <div class="mt-4 text-green-400 font-medium" x-text="message"></div>
            </template>
        </div>
    </div>
</div>
</body>
</html>

<script>
    function proxyApp() {
        return {
            proxyHost: '',
            proxyPort: '',
            newRegex: '',
            regexList: [],
            message: '',
            async init() {
                const json = await (await fetch('/rules')).json();
                this.proxyHost = json.Host;
                this.proxyPort = json.Port;
                this.regexList = json.Regex.slice(3, -3).split('|');
            },
            async submit() {
                const result = await fetch('/rules', {
                    method: 'POST',
                    body: JSON.stringify({Host: this.proxyHost, Port: this.proxyPort, Regex: `.*(${this.regexList.join('|')}).*`})
                });
                this.message = result.ok ? 'Успешно сохранено' : 'Не удалось сохранить';
                setTimeout(() => this.message = '', 5000);
            },
            addRegex() {
                this.regexList = [this.newRegex].concat(this.regexList);
                this.newRegex = '';
            },
            removeRegex(index) {
                this.regexList.splice(index, 1);
            }
        }
    }
</script>
